# Specimen Digitization Platform local configuration
#
# Copy this file to .env and fill only the providers you will use:
#   cp .env.example .env
#
# Never commit .env, credentials, private keys, service-account JSON, museum
# specimen images, raw transcripts, or production exports. Tenant BYOK secrets
# must ultimately live in a cloud secret manager, not in this file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8080
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Firebase / Google Cloud
# Firebase client configuration identifies a Firebase app but must still be
# restricted to the intended APIs, apps, and origins in Google Cloud.
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SECRET_MANAGER_PROJECT_ID=

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=

FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

# Use local emulators until a development Firebase project is configured.
USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# -----------------------------------------------------------------------------
# Temporal
# The defaults work with `temporal server start-dev`. For Temporal Cloud, replace
# the address/namespace and add its API key and TLS server name.
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=specimen-processing
TEMPORAL_API_KEY=
TEMPORAL_TLS_SERVER_NAME=

# -----------------------------------------------------------------------------
# AWS Bedrock BYOK for local development
# Prefer AWS SSO/profile or short-lived role credentials. Do not create a
# long-lived access key solely for this project. Production tenant credentials
# will be referenced through Secret Manager.
# -----------------------------------------------------------------------------
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Vision/model providers
# At least two independent transcription routes will be selected after the
# benchmark. Leave unused provider credentials blank.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# Self-hosted Ollama/vLLM or another OpenAI-compatible model gateway.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# -----------------------------------------------------------------------------
# Insects taxonomy sources
# Global Names Verifier, Catalogue of Life, and normal GBIF species lookups do
# not require an API key for the initial adapter spike. GBIF account credentials
# are optional and only needed for authenticated GBIF/ChecklistBank operations.
# -----------------------------------------------------------------------------
GLOBAL_NAMES_API_BASE_URL=https://verifier.globalnames.org/api/v1
CATALOGUE_OF_LIFE_API_BASE_URL=https://api.checklistbank.org
GBIF_API_BASE_URL=https://api.gbif.org/v1
GBIF_USERNAME=
GBIF_PASSWORD=

# -----------------------------------------------------------------------------
# Field Museum EMu / Parties authority (pending Field IT provisioning)
# The anonymous collections route exposes catalogue records, not a verified
# Parties resolver. Fill only the route Field IT approves. Production secrets
# belong in Secret Manager, not in a checked-in file.
# -----------------------------------------------------------------------------
FMNH_PUBLIC_COLLECTIONS_API_BASE_URL=https://www.fieldmuseum.org/api

FMNH_EMU_API_BASE_URL=
FMNH_EMU_API_TENANT=
FMNH_EMU_API_USERNAME=
FMNH_EMU_API_PASSWORD=

FMNH_ELASTICSEARCH_URL=
FMNH_ELASTICSEARCH_API_KEY=
FMNH_ELASTICSEARCH_EPARTIES_INDEX=

# -----------------------------------------------------------------------------
# Geography and web discovery
# Restrict Google Maps keys by API and server identity/IP before use.
# The search provider remains a product decision; do not place browser-session
# cookies in this file.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE_ID=

# -----------------------------------------------------------------------------
# Observability (optional for initial local development)
# -----------------------------------------------------------------------------
LOGFIRE_TOKEN=
SENTRY_DSN=
