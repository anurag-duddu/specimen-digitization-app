# Specimen Digitization local configuration
#
# Copy this file to .env and fill only the providers you will use:
#   cp .env.example .env
#
# Never commit .env, credentials, private keys, service-account JSON, museum
# specimen images, raw transcripts, or production exports. Tenant BYOK secrets
# must ultimately live in a cloud secret manager, not in this file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8080
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Firebase / Google Cloud
# Keep project-level backend settings here. Flutter client configuration is
# generated in apps/specimen_digitization/lib/firebase_options.dart by
# `flutterfire configure`; do not
# duplicate the platform SDK configuration in this file.
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-east4
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SECRET_MANAGER_PROJECT_ID=

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Use local emulators until a development Firebase project is configured.
USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATACONNECT_EMULATOR_HOST=127.0.0.1:9399
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# -----------------------------------------------------------------------------
# Hugging Face model access
# One server-side token is used for Hugging Face Inference Providers and for
# downloading approved gated model assets such as SAM 3. In production it is
# injected from the `huggingface-runtime-token` Secret Manager secret; never
# expose it to Flutter. HF_BILL_TO is optional and names the approved Hugging
# Face organization or resource group that should receive inference charges.
# -----------------------------------------------------------------------------
HF_TOKEN=
HF_BILL_TO=

# Optional self-hosted vLLM endpoint for approved models that are not currently
# served by Hugging Face Inference Providers, including the Nemotron VLM.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# -----------------------------------------------------------------------------
# Insects taxonomy sources
# Global Names Verifier, Catalogue of Life, and normal GBIF read operations do
# not require an API key. GBIF account credentials use HTTP Basic Authentication
# and are needed for asynchronous occurrence-download requests. Keep the origin
# unversioned because the integration uses both GBIF v1 and v2 paths.
# -----------------------------------------------------------------------------
GLOBAL_NAMES_API_BASE_URL=https://verifier.globalnames.org/api/v1
CATALOGUE_OF_LIFE_API_BASE_URL=https://api.checklistbank.org
GBIF_API_ORIGIN=https://api.gbif.org
GBIF_USERNAME=
GBIF_PASSWORD=

# -----------------------------------------------------------------------------
# Field Museum EMu / Parties authority (pending Field IT provisioning)
# The anonymous collections route exposes catalogue records, not a verified
# Parties resolver. Fill only the route Field IT approves. Production secrets
# belong in Secret Manager, not in a checked-in file.
# -----------------------------------------------------------------------------
FMNH_PUBLIC_COLLECTIONS_API_BASE_URL=https://www.fieldmuseum.org/api

FMNH_EMU_API_BASE_URL=
FMNH_EMU_API_TENANT=
FMNH_EMU_API_USERNAME=
FMNH_EMU_API_PASSWORD=

FMNH_ELASTICSEARCH_URL=
FMNH_ELASTICSEARCH_API_KEY=
FMNH_ELASTICSEARCH_EPARTIES_INDEX=

# -----------------------------------------------------------------------------
# Geography and web discovery
# Restrict Google Maps keys by API and server identity/IP before use.
# The search provider remains a product decision; do not place browser-session
# cookies in this file.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE_ID=

# -----------------------------------------------------------------------------
# Observability (optional for initial local development)
# -----------------------------------------------------------------------------
# Local Python workers use the gitignored credentials created by
# `uvx logfire --non-interactive projects use`; deployments use LOGFIRE_TOKEN
# from Secret Manager. Content capture stays off unless an approved synthetic
# or non-sensitive fixture explicitly requires it.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=specimen-digitization
LOGFIRE_INCLUDE_CONTENT=false
LOGFIRE_INCLUDE_BINARY_CONTENT=false
LOGFIRE_INCLUDE_MODEL_REQUEST_PARAMETERS=false
SENTRY_DSN=
